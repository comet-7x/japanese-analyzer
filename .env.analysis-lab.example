# Copy to .env.analysis-lab.local (ignored by Git). Never commit real credentials.
ANALYSIS_LAB_BASE_URL=https://api.example.com/v1
ANALYSIS_LAB_MODEL=your-model-name
ANALYSIS_LAB_API_KEY=replace-locally
# Explicit provider capabilities; thinking is disabled when the model supports it.
ANALYSIS_LAB_CAPS='{"thinking":true,"structuredOutput":"json_schema"}'
